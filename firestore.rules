rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Put your school Google email here too (same as js/firebase-config.js).
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["ariana.flatt@unbound.school"];
    }

    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isTeacher();

      match /students/{studentId} {
        allow read: if request.auth != null;
        allow create, delete: if isTeacher();

        // Students (anonymous sign-in) may only change their own look:
        // pick a companion once, rename it, choose gear and sidekick.
        allow update: if isTeacher() || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["companionId", "petName", "equipped", "sidekick"])
          && (request.resource.data.companionId == resource.data.companionId
              || resource.data.companionId == null)
          && request.resource.data.companionId in [null, "otter","raccoon","fox","sloth","badger","octopus",
               "dragon","unicorn","griffin","sprite","pixie","golem"]
          && request.resource.data.petName is string
          && request.resource.data.petName.size() <= 22
          && request.resource.data.equipped in [null, "", "cap", "shades", "snack", "hat", "crown"]
          && request.resource.data.sidekick in ["axolotl", "duck"]
        );
      }
    }
  }
}
